      "required": [
        "evidence_id"
      ],
      "title": "EvidenceKnowledgeGrant",
      "type": "object"
    },
    "EvidencePresentedCondition": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 100,
