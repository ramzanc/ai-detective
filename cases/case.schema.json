      },
      "required": [
        "fact_id"
      ],
      "title": "FactKnownCondition",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "points_to_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Points To Evidence Ids",
          "type": "array"
        },
        "requires_fact_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Requires Fact Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/HintTier"
        }
      },
      "required": [
        "id",
        "tier",
        "text"
      ],
      "title": "Hint",
      "type": "object"
    },
