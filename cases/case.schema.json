    "RubricCriterion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/SupportCategory"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "weight": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "category",
        "description",
        "supporting_evidence_ids"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "SolutionRubric": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
