        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "minimum_score": {
          "minimum": 1,
          "title": "Minimum Score",
          "type": "integer"
        }
      },
      "required": [
        "culprit_character_id",
        "explanation",
        "criteria",
        "minimum_score"
