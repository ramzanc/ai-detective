          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Event Id",
          "type": "string"
        },
        "kind": {
          "const": "timeline_event",
          "default": "timeline_event",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "EventKnowledgeGrant",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "available_during": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "location_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Location Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reveals_fact_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Reveals Fact Ids",
          "type": "array"
        },
        "unlocks_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Unlocks Evidence Ids",
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility",
          "default": "discoverable"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "location_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "physical",
        "document",
        "digital",
        "testimony"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceKnowledgeGrant": {
      "additionalProperties": false,
