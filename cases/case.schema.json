        "$ref": "#/$defs/BehaviorRule"
      },
      "title": "Behavior Rules",
      "type": "array"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/Character"
      },
      "minItems": 1,
      "title": "Characters",
      "type": "array"
    },
    "evidence": {
