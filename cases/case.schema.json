{
  "$defs": {
    "AlwaysCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "always",
          "default": "always",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "AlwaysCondition",
      "type": "object"
    },
    "BehaviorRule": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Character Id",
          "type": "string"
        },
        "condition": {
          "discriminator": {
            "mapping": {
              "always": "#/$defs/AlwaysCondition",
              "contradiction_found": "#/$defs/ContradictionFoundCondition",
              "evidence_presented": "#/$defs/EvidencePresentedCondition",
              "fact_known": "#/$defs/FactKnownCondition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AlwaysCondition"
            },
            {
              "$ref": "#/$defs/FactKnownCondition"
            },
            {
              "$ref": "#/$defs/EvidencePresentedCondition"
            },
            {
              "$ref": "#/$defs/ContradictionFoundCondition"
            }
          ],
          "title": "Condition"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "reveal_fact_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Reveal Fact Ids",
          "type": "array"
        },
        "strategy": {
          "$ref": "#/$defs/BehaviorStrategy"
        }
      },
      "required": [
        "id",
        "character_id",
        "priority",
        "condition",
        "strategy"
      ],
      "title": "BehaviorRule",
      "type": "object"
    },
    "BehaviorStrategy": {
      "enum": [
        "cooperate",
        "evade",
        "deflect",
        "deny",
        "reveal",
        "confess"
      ],
      "title": "BehaviorStrategy",
      "type": "string"
    },
    "CaseManifestMetadata": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "version",
        "title",
        "summary",
        "author",
        "published_at"
      ],
      "title": "CaseManifestMetadata",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "knowledge_grants": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "evidence": "#/$defs/EvidenceKnowledgeGrant",
                "fact": "#/$defs/FactKnowledgeGrant",
                "timeline_event": "#/$defs/EventKnowledgeGrant"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FactKnowledgeGrant"
              },
              {
                "$ref": "#/$defs/EvidenceKnowledgeGrant"
              },
              {
                "$ref": "#/$defs/EventKnowledgeGrant"
              }
            ]
          },
          "title": "Knowledge Grants",
          "type": "array"
        },
        "name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "private_motivation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Private Motivation",
          "type": "string"
        },
        "public_description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Public Description",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/CharacterRole"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "public_description",
        "private_motivation"
      ],
      "title": "Character",
      "type": "object"
    },
    "CharacterRole": {
      "enum": [
        "suspect",
        "witness",
        "victim",
        "other"
      ],
      "title": "CharacterRole",
      "type": "string"
    },
    "ContradictionFoundCondition": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "const": "contradiction_found",
          "default": "contradiction_found",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "fact_id"
      ],
      "title": "ContradictionFoundCondition",
      "type": "object"
    },
    "EventKnowledgeGrant": {
      "additionalProperties": false,
