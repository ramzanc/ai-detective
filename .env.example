# --- App ---
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_detective
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- AI provider ---
AI_PROVIDER=openai        # provider name, abstracted behind LLMClient (Day 21)
AI_MODEL=                      # set per environment, never hardcoded
AI_API_KEY=                    # never commit a real value
AI_REQUEST_TIMEOUT_SECONDS=15

# --- Auth / tokens ---
SESSION_TOKEN_SECRET=          # used to sign guest resume tokens (Day 6)

# --- Feature flags ---
FEATURE_AI_INTERROGATION_ENABLED=false   # kept false until Milestone 4 lands